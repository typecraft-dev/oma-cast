#!/bin/bash
# oma-cast: control the oma-cast launcher plugin running inside omarchy-shell.
#
# Runtime calls go through omarchy-shell, which answers over the shell's own
# socket (~5 ms). The launcher hotkey does not use this script at all: it is a
# Hyprland global shortcut, oma-cast:toggle, that the plugin registers.

set -uo pipefail

PLUGIN_ID="typecraft.oma-cast"
IPC_TARGET="oma-cast"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)
plugin_src="$repo/plugin"
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin_link="$plugins_dir/$PLUGIN_ID"

# Our links in the plugins dir: the install link, or a reload link (below).
installed_links() {
  local link
  for link in "$plugin_link" "$plugin_link".dev-*; do
    [[ -L $link && $(readlink -f "$link") == "$plugin_src" ]] && printf '%s\n' "$link"
  done
}

current_link() { installed_links | tail -n1; }
hypr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"

usage() {
  cat <<USAGE
Usage: oma-cast <command> [args]

Launcher
  toggle                 Show or hide the launcher
  show | hide            Show or hide it
  run <commandId>        Open a command directly
  call <method> [json]   Call a backend method, e.g. oma-cast call system.info

Setup
  install                Link the plugin into omarchy-shell, enable it, and link this CLI into ~/.local/bin
  uninstall              Disable and unlink the plugin
  reload                 Make the shell reload the plugin after editing it
  dev                    Reload the plugin on every save under plugin/
  setup hyprland         Bind Alt+Space to the launcher in ~/.config/hypr/oma-cast.lua
  doctor                 Check that the pieces are in place
USAGE
}

die() { echo "oma-cast: $*" >&2; exit 1; }

ipc() { omarchy-shell "$IPC_TARGET" "$@"; }

# The shell reports a QML error in its own log, so a plugin that fails to
# load looks identical to one that was never installed. Pull the QML errors
# for our plugin out of the log so the message names the real cause.
#
# Only the current link counts: `oma-cast reload` links the plugin under a new
# path each time, and the log keeps the errors of the paths before it, which
# would otherwise report a failure that has already been fixed.
plugin_qml_errors() {
  command -v qs >/dev/null || return 0
  [[ -n ${OMARCHY_PATH:-} ]] || return 0
  local link name
  link=$(current_link)
  [[ -n $link ]] || return 0
  name=$(basename "$link")
  qs log -n --no-color -p "$OMARCHY_PATH/shell" -t 400 2>/dev/null \
    | grep -E "plugins/${name}/.*\.(qml|js).*(is not a type|is not a module|ReferenceError|TypeError|Unable to assign|Cannot )" \
    | tail -n 5
}

report_load_failure() {
  local errors
  errors=$(plugin_qml_errors)
  if [[ -n $errors ]]; then
    echo "oma-cast: the plugin did not load; the shell log says:" >&2
    printf '%s\n' "$errors" | sed 's/^/  /' >&2
  else
    echo "oma-cast: plugin did not answer; check the shell log with: qs log -n -p \"\$OMARCHY_PATH/shell\"" >&2
  fi
}

need_shell() {
  command -v omarchy-shell >/dev/null || die "omarchy-shell not found; oma-cast runs inside the Omarchy shell"
}

cmd_install() {
  need_shell
  [[ -f $plugin_src/manifest.json ]] || die "plugin source missing at $plugin_src"
  mkdir -p "$plugins_dir"
  if [[ -e $plugin_link && ! -L $plugin_link ]]; then
    die "$plugin_link exists and is not a symlink; move it away first"
  fi

  # Quickshell keeps every QML/JS file it has read, keyed by path, for the
  # life of the process. Re-linking the same path therefore serves the file
  # the shell cached earlier, so an upgrade over a path it already read
  # would keep running the old code (or keep failing on a type the new code
  # no longer uses). Link under a path the shell has not read, and drop the
  # old links; the plugin id comes from the manifest, not the directory name.
  local old link
  while IFS= read -r old; do
    [[ -n $old ]] && rm "$old" && echo "removed stale link $old"
  done < <(installed_links)
  link="$plugin_link.dev-$(date +%s%N)"
  ln -s "$plugin_src" "$link"
  echo "linked $link -> $plugin_src"

  mkdir -p "$HOME/.local/bin"
  if [[ ! -e $HOME/.local/bin/oma-cast || -L $HOME/.local/bin/oma-cast ]]; then
    ln -sfn "$self" "$HOME/.local/bin/oma-cast"
    echo "linked ~/.local/bin/oma-cast"
  fi

  omarchy-shell -q shell rescanPlugins
  # The scan runs in the background; enable answers "not ready" until it lands.
  local out i
  for i in $(seq 1 50); do
    out=$(omarchy plugin enable "$PLUGIN_ID" 2>&1) && break
    [[ $out == *"not ready"* || $out == *"could not find"* || $out == *"not known"* ]] || break
    sleep 0.1
  done
  [[ -n $out ]] && echo "$out"

  for i in $(seq 1 100); do
    [[ $(omarchy-shell "$IPC_TARGET" ping 2>/dev/null) == "ok" ]] && { echo "oma-cast is running"; return 0; }
    sleep 0.1
  done
  report_load_failure
  exit 1
}

cmd_uninstall() {
  need_shell
  omarchy plugin disable "$PLUGIN_ID" 2>/dev/null || true
  local link
  while IFS= read -r link; do
    [[ -n $link ]] && rm "$link" && echo "removed $link"
  done < <(installed_links)
  omarchy-shell -q shell rescanPlugins
  if [[ -L $HOME/.local/bin/oma-cast && $(readlink -f "$HOME/.local/bin/oma-cast") == "$self" ]]; then
    rm "$HOME/.local/bin/oma-cast" && echo "removed ~/.local/bin/oma-cast"
  fi
}

# Reloading after an edit needs two things the shell will not do for a
# symlinked plugin: its inotify watch does not follow the link into the repo,
# and Quickshell keeps every QML file it has read, by path, for the life of
# the process (clearComponentCache does not drop them). So each reload links
# the plugin under a path the shell has never seen. The directory name is
# free; the plugin id comes from manifest.json.
cmd_reload() {
  [[ -n $(current_link) ]] || die "plugin is not installed; run: oma-cast install"
  local old
  while IFS= read -r old; do rm "$old"; done < <(installed_links)
  ln -s "$plugin_src" "$plugin_link.dev-$(date +%s%N)"
}

cmd_dev() {
  command -v inotifywait >/dev/null || die "inotifywait not found (inotify-tools)"
  cmd_reload
  echo "watching $plugin_src; Ctrl+C to stop"
  inotifywait -m -r -q -e close_write,create,delete,move --format '%w%f' "$plugin_src" |
    while read -r path; do
      echo "changed ${path#"$plugin_src"/}"
      cmd_reload
    done
}

# Hyprland on Omarchy is configured in Lua. Write our own file and require it
# once from hyprland.lua; never edit Omarchy's files or the user's bindings.
cmd_setup_hyprland() {
  [[ -f $hypr_dir/hyprland.lua ]] || die "no $hypr_dir/hyprland.lua; this setup targets Lua-configured Hyprland (hyprctl version: $(hyprctl version 2>/dev/null | head -1))"

  local conflicts
  conflicts=$(grep -rnE '"ALT \+ SPACE"|ALT, ?SPACE' "$hypr_dir" "${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr" 2>/dev/null | grep -v "$hypr_dir/oma-cast.lua" | grep -vE '^\S+:[0-9]+:\s*(--|#)')
  if [[ -n $conflicts ]]; then
    echo "Alt+Space is already bound:" >&2
    echo "$conflicts" >&2
    die "unbind it first, or edit $hypr_dir/oma-cast.lua to use another key"
  fi

  cat >"$hypr_dir/oma-cast.lua" <<'LUA'
-- Written by `oma-cast setup hyprland`. Safe to edit; rerunning setup overwrites it.
-- Alt+Space reaches the plugin's global shortcut directly, so no process
-- starts per keypress. Omarchy's own menu stays on Super+Space.
o.bind("ALT + SPACE", "oma-cast launcher", hl.dsp.global("oma-cast:toggle"))

-- To put oma-cast on Super+Space instead of the Omarchy menu:
-- hl.unbind("SUPER + SPACE")
-- o.bind("SUPER + SPACE", "oma-cast launcher", hl.dsp.global("oma-cast:toggle"))
LUA
  echo "wrote $hypr_dir/oma-cast.lua"

  if ! grep -qE '^\s*require\("hypr\.oma-cast"\)' "$hypr_dir/hyprland.lua"; then
    printf '\n-- oma-cast launcher bindings\nrequire("hypr.oma-cast")\n' >>"$hypr_dir/hyprland.lua"
    echo "added require(\"hypr.oma-cast\") to $hypr_dir/hyprland.lua"
  fi
  hyprctl reload >/dev/null && echo "reloaded Hyprland; Alt+Space toggles oma-cast"
}

cmd_doctor() {
  local bad=0
  check() { # check <label> <command...>
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  echo "oma-cast doctor"
  check "omarchy-shell is installed" command -v omarchy-shell
  check "omarchy-shell is running" omarchy-shell shell ping
  check "socat is installed (fast shell IPC)" command -v socat
  check "Hyprland socket is reachable" hyprctl version
  check "plugin is linked into $plugins_dir" test -n "$(current_link)"
  check "plugin is enabled" bash -c "omarchy plugin list --json 2>/dev/null | grep -q '\"id\":\"$PLUGIN_ID\"[^}]*\"enabled\":true'"
  check "plugin answers IPC" bash -c "[[ \$(omarchy-shell $IPC_TARGET ping) == ok ]]"
  check "backend answers system.healthPing" bash -c "omarchy-shell $IPC_TARGET call system.healthPing '{}' | grep -q '\"ok\":true'"
  # A plugin that failed to load answers nothing, so name the QML error that
  # stopped it instead of leaving "plugin answers IPC" as the whole story.
  local errors
  errors=$(plugin_qml_errors)
  if [[ -n $errors ]]; then
    printf '  FAIL  plugin loaded without QML errors\n'
    printf '%s\n' "$errors" | sed 's/^/        /'
    bad=1
  fi
  if [[ -f $hypr_dir/oma-cast.lua ]]; then
    printf '  ok    hotkey file %s\n' "$hypr_dir/oma-cast.lua"
  else
    printf '  info  no hotkey yet; run: oma-cast setup hyprland\n'
  fi
  return $bad
}

case "${1:-}" in
  toggle|show|hide) need_shell; ipc "$1" >/dev/null ;;
  run) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast run <commandId>"; ipc run "$2" ;;
  call) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast call <method> [json]"; ipc call "$2" "${3:-}" ;;
  ping) need_shell; ipc ping ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  reload) cmd_reload ;;
  dev) cmd_dev ;;
  setup)
    case "${2:-}" in
      hyprland) cmd_setup_hyprland ;;
      *) die "usage: oma-cast setup hyprland" ;;
    esac
    ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
