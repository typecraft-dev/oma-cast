#!/bin/bash

set -uo pipefail

PLUGIN_ID="typecraft.oma-cast"
IPC_TARGET="oma-cast"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)
plugin_src="$repo/plugin"
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin_link="$plugins_dir/$PLUGIN_ID"

installed_links() {
  local link
  for link in "$plugin_link" "$plugin_link".dev-*; do
    [[ -L $link && $(readlink -f "$link") == "$plugin_src" ]] && printf '%s\n' "$link"
  done
}

current_link() { installed_links | tail -n1; }
hypr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/oma-cast"
settings_file="$data_dir/db/settings.json"
helper_local="$HOME/.local/lib/oma-cast/oma-cast-files"
helper_system="/usr/lib/oma-cast/oma-cast-files"

helper_present() {
  local candidate
  for candidate in "${OMA_CAST_FILES_BIN:-}" "$helper_local" "$helper_system"; do
    [[ -n $candidate && -x $candidate ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

build_helper() {
  command -v cargo >/dev/null || {
    echo "oma-cast: cargo not found; install rust to build the file search helper" >&2
    return 1
  }
  echo "building the file search helper (cargo, one-time)…"
  cargo build --release --locked --manifest-path "$repo/helper/Cargo.toml" || return 1
  mkdir -p "$(dirname "$helper_local")"
  install -Dm755 "$repo/helper/target/release/oma-cast-files" "$helper_local.new" || return 1
  mv -f "$helper_local.new" "$helper_local" || return 1
  echo "installed $helper_local"
  echo "run 'oma-cast reload' to restart a running helper with the new binary"
}

usage() {
  cat <<USAGE
Usage: oma-cast <command> [args]

Launcher
  toggle                 Show or hide the launcher
  show | hide            Show or hide it
  run <commandId>        Open a command directly
  call <method> [json]   Call a backend method, e.g. oma-cast call system.info

Setup
  install                Link the plugin into omarchy-shell, enable it, and link this CLI into ~/.local/bin
  uninstall              Disable and unlink the plugin
  reload                 Make the shell reload the plugin after editing it
  dev                    Reload the plugin on every save under plugin/
  setup hyprland         Bind Alt+Space to the launcher in ~/.config/hypr/oma-cast.lua
  doctor                 Check that the pieces are in place

File search
  files build            Build and install the optional search helper (cargo)
  files status           Show the cached helper status (does not start it)
  files enable|disable   Turn file search on or off
  files root [<path>]    Show or set the indexed root
  files reindex          Rescan the configured root
  files reset-ranking    Clear the file access ranking
  files retry            Retry after building a missing helper
USAGE
}

die() { echo "oma-cast: $*" >&2; exit 1; }

ipc() { omarchy-shell "$IPC_TARGET" "$@"; }

need_shell() {
  command -v omarchy-shell >/dev/null || die "omarchy-shell not found; oma-cast runs inside the Omarchy shell"
}

cmd_install() {
  need_shell
  [[ -f $plugin_src/manifest.json ]] || die "plugin source missing at $plugin_src"

  local new_install=0
  [[ -f $settings_file ]] || new_install=1

  mkdir -p "$plugins_dir"
  if [[ -e $plugin_link && ! -L $plugin_link ]]; then
    die "$plugin_link exists and is not a symlink; move it away first"
  fi
  ln -sfn "$plugin_src" "$plugin_link"
  echo "linked $plugin_link -> $plugin_src"

  mkdir -p "$HOME/.local/bin"
  if [[ ! -e $HOME/.local/bin/oma-cast || -L $HOME/.local/bin/oma-cast ]]; then
    ln -sfn "$self" "$HOME/.local/bin/oma-cast"
    echo "linked ~/.local/bin/oma-cast"
  fi

  if (( new_install )); then
    echo "New install: file search is enabled by default (index starts on first use)."
    echo "Disable later with: oma-cast files disable"
    if command -v cargo >/dev/null; then
      build_helper || echo "oma-cast: warning: helper build failed; run: oma-cast files build" >&2
    else
      echo "oma-cast: warning: cargo not found; run 'oma-cast files build' after installing Rust" >&2
    fi
  else
    local existing_enabled=false
    existing_enabled=$(python3 -I -c 'import json,sys; print(str(json.load(open(sys.argv[1])).get("files",{}).get("enabled", False)).lower())' "$settings_file" 2>/dev/null || echo false)
    if [[ $existing_enabled == true ]]; then
      echo "File search is enabled (existing settings); helper: $(helper_present || echo 'not installed')"
    else
      echo "File search is off for existing installs; opt in with: oma-cast files build && oma-cast files enable"
    fi
  fi

  omarchy-shell -q shell rescanPlugins
  local out i
  for i in $(seq 1 50); do
    out=$(omarchy plugin enable "$PLUGIN_ID" 2>&1) && break
    [[ $out == *"not ready"* || $out == *"could not find"* || $out == *"not known"* ]] || break
    sleep 0.1
  done
  [[ -n $out ]] && echo "$out"

  for i in $(seq 1 100); do
    [[ $(omarchy-shell "$IPC_TARGET" ping 2>/dev/null) == "ok" ]] && { echo "oma-cast is running"; return 0; }
    sleep 0.1
  done
  die "plugin did not answer; check the shell log with: qs log -n -p \"\$OMARCHY_PATH/shell\""
}

cmd_uninstall() {
  need_shell
  omarchy plugin disable "$PLUGIN_ID" 2>/dev/null || true
  local link
  while IFS= read -r link; do
    [[ -n $link ]] && rm "$link" && echo "removed $link"
  done < <(installed_links)
  omarchy-shell -q shell rescanPlugins
  if [[ -L $HOME/.local/bin/oma-cast && $(readlink -f "$HOME/.local/bin/oma-cast") == "$self" ]]; then
    rm "$HOME/.local/bin/oma-cast" && echo "removed ~/.local/bin/oma-cast"
  fi
  if [[ -f $helper_local ]]; then
    rm -f "$helper_local" && echo "removed $helper_local"
  fi
}

cmd_reload() {
  [[ -n $(current_link) ]] || die "plugin is not installed; run: oma-cast install"
  local old
  while IFS= read -r old; do rm "$old"; done < <(installed_links)
  ln -s "$plugin_src" "$plugin_link.dev-$(date +%s%N)"
}

cmd_dev() {
  command -v inotifywait >/dev/null || die "inotifywait not found (inotify-tools)"
  cmd_reload
  echo "watching $plugin_src; Ctrl+C to stop"
  inotifywait -m -r -q -e close_write,create,delete,move --format '%w%f' "$plugin_src" |
    while read -r path; do
      echo "changed ${path#"$plugin_src"/}"
      cmd_reload
    done
}

cmd_setup_hyprland() {
  [[ -f $hypr_dir/hyprland.lua ]] || die "no $hypr_dir/hyprland.lua; this setup targets Lua-configured Hyprland (hyprctl version: $(hyprctl version 2>/dev/null | head -1))"

  local conflicts
  conflicts=$(grep -rnE '"ALT \+ SPACE"|ALT, ?SPACE' "$hypr_dir" "${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr" 2>/dev/null | grep -v "$hypr_dir/oma-cast.lua" | grep -vE '^\S+:[0-9]+:\s*(--|#)')
  if [[ -n $conflicts ]]; then
    echo "Alt+Space is already bound:" >&2
    echo "$conflicts" >&2
    die "unbind it first, or edit $hypr_dir/oma-cast.lua to use another key"
  fi

  cat >"$hypr_dir/oma-cast.lua" <<'LUA'
o.bind("ALT + SPACE", "oma-cast launcher", hl.dsp.global("oma-cast:toggle"))

LUA
  echo "wrote $hypr_dir/oma-cast.lua"

  if ! grep -qE '^\s*require\("hypr\.oma-cast"\)' "$hypr_dir/hyprland.lua"; then
    printf '\nrequire("hypr.oma-cast")\n' >>"$hypr_dir/hyprland.lua"
    echo "added require(\"hypr.oma-cast\") to $hypr_dir/hyprland.lua"
  fi
  hyprctl reload >/dev/null && echo "reloaded Hyprland; Alt+Space toggles oma-cast"
}

cmd_files() {
  case "${1:-}" in
    build) build_helper ;;
    status) need_shell; ipc call files.status '{}' ;;
    enable)
      helper_present >/dev/null || die "file search helper not found; run: oma-cast files build"
      need_shell
      ipc call files.updateSettings '{"enabled":true}'
      ;;
    disable) need_shell; ipc call files.updateSettings '{"enabled":false}' ;;
    root)
      need_shell
      if [[ -n ${2:-} ]]; then
        command -v jq >/dev/null || die "jq is required to encode the path"
        local json
        json=$(jq -cn --arg root "$2" '{root:$root}')
        ipc call files.updateSettings "$json"
      else
        ipc call files.status '{}' | python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d.get("data",{}).get("root",""))'
      fi
      ;;
    reindex) need_shell; ipc call files.reindex '{}' ;;
    reset-ranking) need_shell; ipc call files.resetRanking '{}' ;;
    retry) need_shell; ipc call files.retry '{}' ;;
    *) die "usage: oma-cast files build|status|enable|disable|root [path]|reindex|reset-ranking|retry" ;;
  esac
}

cmd_doctor() {
  local bad=0
  check() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  echo "oma-cast doctor"
  check "omarchy-shell is installed" command -v omarchy-shell
  check "omarchy-shell is running" omarchy-shell shell ping
  check "socat is installed (fast shell IPC)" command -v socat
  check "Hyprland socket is reachable" hyprctl version
  check "plugin is linked into $plugins_dir" test -n "$(current_link)"
  check "plugin is enabled" bash -c "omarchy plugin list --json 2>/dev/null | grep -q '\"id\":\"$PLUGIN_ID\"[^}]*\"enabled\":true'"
  check "plugin answers IPC" bash -c "[[ \$(omarchy-shell $IPC_TARGET ping) == ok ]]"
  check "backend answers system.healthPing" bash -c "omarchy-shell $IPC_TARGET call system.healthPing '{}' | grep -q '\"ok\":true'"

  local helper files_json files_enabled files_state files_error indexed rss
  files_field() {
    printf '%s' "$files_json" | python3 -I -c 'import json,sys; d=json.load(sys.stdin).get("data",{}); v=d.get(sys.argv[1],""); print(str(v).lower() if isinstance(v,bool) else v)' "$1" 2>/dev/null
  }
  helper=$(helper_present || true)
  files_json=$(omarchy-shell "$IPC_TARGET" call files.status '{}' 2>/dev/null || true)
  files_enabled=$(files_field enabled)
  files_state=$(files_field state)
  files_error=$(files_field error)
  indexed=$(files_field indexedFiles)
  rss=$(files_field rssMb)

  if [[ -n $helper ]]; then
    printf '  ok    file search helper %s\n' "$helper"
  elif [[ $files_enabled == true ]]; then
    printf '  FAIL  file search helper missing; run: oma-cast files build\n'
    bad=1
  else
    printf '  info  file search helper not installed\n'
  fi

  if [[ $files_enabled == true ]]; then
    case $files_state in
      error)
        printf '  FAIL  file search: %s\n' "${files_error:-unknown error}"
        bad=1
        ;;
      stopped|disabled)
        printf '  info  file search enabled; starts on the first file query\n'
        ;;
      "")
        printf '  info  file search state unavailable (plugin not answering?)\n'
        ;;
      *)
        printf '  ok    file search %s (%s files, %s MB RSS)\n' "$files_state" "${indexed:-0}" "${rss:-0}"
        ;;
    esac
  elif [[ -z $files_enabled ]]; then
    printf '  info  file search state unavailable (plugin not answering?)\n'
  else
    printf '  info  file search disabled; oma-cast files build && oma-cast files enable\n'
  fi

  if [[ -f $hypr_dir/oma-cast.lua ]]; then
    printf '  ok    hotkey file %s\n' "$hypr_dir/oma-cast.lua"
  else
    printf '  info  no hotkey yet; run: oma-cast setup hyprland\n'
  fi
  return $bad
}

case "${1:-}" in
  toggle|show|hide) need_shell; ipc "$1" >/dev/null ;;
  run) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast run <commandId>"; ipc run "$2" ;;
  call) need_shell; [[ -n ${2:-} ]] || die "usage: oma-cast call <method> [json]"; ipc call "$2" "${3:-}" ;;
  ping) need_shell; ipc ping ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  reload) cmd_reload ;;
  dev) cmd_dev ;;
  files) cmd_files "${2:-}" "${3:-}" ;;
  setup)
    case "${2:-}" in
      hyprland) cmd_setup_hyprland ;;
      *) die "usage: oma-cast setup hyprland" ;;
    esac
    ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
